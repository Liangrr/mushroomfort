; Engine configuration file.
; Gameplay input actions are registered in code (scripts/core/controls.gd).

config_version=5

[application]

config/name="蘑菇要塞 Mushroom Garrison"
config/description="A hand-painted 2D tower defense: blooming mushroom turrets guard the forest seed vault."
config/use_custom_user_dir=true
config/custom_user_dir_name="MushroomGarrison"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/mg/ui/icon_seed.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.114, 0.149, 0.086, 1)

[audio]

general/default_playback_type=1

[autoload]

TestRunGuard="*res://autoloads/test_run_guard.gd"
Save="*res://scripts/core/save.gd"
Loc="*res://scripts/core/loc.gd"
GameData="*res://scripts/core/game_data.gd"
GameVersion="*res://scripts/core/version.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
Sound="*res://scripts/core/sound.gd"
Controls="*res://scripts/core/controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor]

export/convert_text_resources_to_binary=false
import/use_multiple_threads=false

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
