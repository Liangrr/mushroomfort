; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fablewood: Keepers of the Last Seed"
; Preserve existing saves when changing the display title.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Fablewood"
config/custom_user_dir_name.linux="godot/app_userdata/Fablewood"
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/template/share/grove-20260924/favicon.png"
boot_splash/image="res://assets/template/Interface/illuminated_seed_splash.webp"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.055, 0.063, 0.098, 1)

[audio]

general/default_playback_type=1

[autoload]

TestRunGuard="*res://autoloads/test_run_guard.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
CursorManager="*res://autoloads/cursor_manager.gd"
I18n="*res://autoloads/i18n.gd"
Music="*res://autoloads/music.gd"
TextScale="*res://autoloads/text_scale.gd"
UiFeedback="*res://autoloads/ui_feedback.gd"
ContentPacks="*res://autoloads/content_pack_loader.gd"
Leaderboard="*res://autoloads/leaderboard.gd"
Game="*res://autoloads/game.gd"
Sfx="*res://autoloads/sfx.gd"
TweakControls="*res://scripts/fablewood/tuning.gd"
TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor]

export/convert_text_resources_to_binary=false

import/use_multiple_threads=false

